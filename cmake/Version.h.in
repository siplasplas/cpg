#pragma once

// The version of cpg a program is built with (these macros), and the
// version of the library it runs with (libraryVersion(): a shared libcpg can
// be another one). Generated by CMake from cmake/Version.h.in.
//
// CPG_ABI_VERSION changes whenever the binary interface does (a class's
// layout, virtual functions, a signature); it is the shared library's
// SONAME (libcpg.so.<ABI>), so the system loads no other one. Within one
// ABI a newer library only adds things, and code built for an older one
// keeps working with it.

#define CPG_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define CPG_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define CPG_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define CPG_VERSION_STRING "@PROJECT_VERSION@"
#define CPG_ABI_VERSION @CPG_ABI_VERSION@

namespace cpg {

struct LibraryVersion {
    int abi;
    int major;
    int minor;
    int patch;
};

// The version of the cpg library running (built into it).
LibraryVersion libraryVersion();

// Whether the running library fits the headers this code was built with:
// the same ABI, and the same version or a newer one (it may have more).
inline bool libraryFits()
{
    const LibraryVersion v = libraryVersion();
    if (v.abi != CPG_ABI_VERSION)
        return false;
    if (v.major != CPG_VERSION_MAJOR)
        return v.major > CPG_VERSION_MAJOR;
    if (v.minor != CPG_VERSION_MINOR)
        return v.minor > CPG_VERSION_MINOR;
    return v.patch >= CPG_VERSION_PATCH;
}

} // namespace cpg
