@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(ICU COMPONENTS uc i18n)
find_dependency(ZLIB)

include("${CMAKE_CURRENT_LIST_DIR}/cpgTargets.cmake")

# Runtime data for detection (languages.txt and the n-gram models).
set_and_check(CPG_LANGUAGES_FILE "@PACKAGE_CMAKE_INSTALL_DATADIR@/cpg/languages.txt")
set_and_check(CPG_MODELS_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/cpg/models")

check_required_components(cpg)
